// Consulta DAX usada na ação Premium "Run a query against a dataset" (Power BI)
// dentro do fluxo do Power Automate. Retorna as colunas necessárias para
// popular o Arquivo_Modelo_-_Controle_de_Estoque.xlsx (via PopularArquivoEstoque.ts).
//
// "Region" e "UserName" foram incluídas por serem exigidas pelo script de
// preenchimento (../scripts/PopularArquivoEstoque.ts) — confirme que esses
// dois nomes de coluna existem exatamente assim na tabela publicada
// "ALL ASSETS - ENVIO DE CONTROLE DE ESTOQUE"; ajuste os nomes se o dataset
// usar rótulos diferentes.

EVALUATE
SELECTCOLUMNS(
    'ALL ASSETS - ENVIO DE CONTROLE DE ESTOQUE',
    "Group_Type", 'ALL ASSETS - ENVIO DE CONTROLE DE ESTOQUE'[Group_Type],
    "Type", 'ALL ASSETS - ENVIO DE CONTROLE DE ESTOQUE'[Type],
    "Manufacturer", 'ALL ASSETS - ENVIO DE CONTROLE DE ESTOQUE'[Manufacturer],
    "Model", 'ALL ASSETS - ENVIO DE CONTROLE DE ESTOQUE'[Model],
    "Serial Number", 'ALL ASSETS - ENVIO DE CONTROLE DE ESTOQUE'[Serial Number],
    "Inventory Number", 'ALL ASSETS - ENVIO DE CONTROLE DE ESTOQUE'[Inventory Number],
    "Status", 'ALL ASSETS - ENVIO DE CONTROLE DE ESTOQUE'[Status],
    "Sub Region", 'ALL ASSETS - ENVIO DE CONTROLE DE ESTOQUE'[Sub Region],
    "Location", 'ALL ASSETS - ENVIO DE CONTROLE DE ESTOQUE'[Location],
    "Region", 'ALL ASSETS - ENVIO DE CONTROLE DE ESTOQUE'[Region],
    "UserName", 'ALL ASSETS - ENVIO DE CONTROLE DE ESTOQUE'[UserName]
)
ORDER BY [Sub Region], [Location]
